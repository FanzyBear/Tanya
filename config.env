# config.env — Recon Pipeline Configuration
# Copy this file and fill in your values.
# Loaded automatically by recon.sh

# ── Telegram Alerts (optional) ────────────────────────────────
# Get your token from @BotFather on Telegram
# Get your chat ID from @userinfobot
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── GitHub Token (for GitHub recon module) ────────────────────
GITHUB_TOKEN=""

# ── Shodan API Key ────────────────────────────────────────────
SHODAN_API_KEY=""

# ── Rate Limits ───────────────────────────────────────────────
# Threads for HTTP probing (default: 50)
HTTPX_THREADS=50

# Threads for port scanning (default: 100)
NAABU_THREADS=100
