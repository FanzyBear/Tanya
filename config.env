# ============================================================
#  config.env — tanya configuration  (v6.2)
#
#  Drop this file next to tanya.sh. It is sourced at startup.
#  All keys are optional — uncomment + edit any line to override.
# ============================================================

# ── Threading & rate limits ──────────────────────────────────
HTTPX_THREADS=100
NAABU_THREADS=200
NAABU_RATE=2000
FFUF_THREADS=100
KATANA_DEPTH=5

# ── Nuclei tuning ────────────────────────────────────────────
# NUCLEI_RATE=150           # max requests/sec (-rl)
# NUCLEI_CONC=25            # template concurrency (-c)
# NUCLEI_RETRIES=1
# NUCLEI_TIMEOUT=10

# ── Edge challenge detection ──────────────────────────────────
# CHALLENGE_THREADS=15      # parallel workers for anti-bot fingerprinting

# ── Wordlists ────────────────────────────────────────────────
FFUF_WORDLIST="$HOME/SecLists-master/Discovery/Web-Content/common.txt"
# DNS_WORDLIST="$HOME/SecLists/Discovery/DNS/subdomains-top1million-5000.txt"

# ── User-agents ──────────────────────────────────────────────
# CURL_UA="Mozilla/5.0 (recon; +tanya.sh)"
# BROWSER_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"

# ── API keys (blank = feature silently skipped) ───────────────
# Enables passive IP history in the origin-discovery module.
SECURITYTRAILS_API_KEY=""
SHODAN_API_KEY=""
# CHAOS_KEY=""              # ProjectDiscovery chaos dataset (-key flag)

# ── Feature toggles ──────────────────────────────────────────
# PASSIVE=false             # set to true to skip all active scans globally
